{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Contract v1",
  "type": "object",
  "required": ["version", "source_sgdb", "type", "source_config"],
  "properties": {
    "version": { "const": "v1" },
    "source_sgdb": {
      "enum": ["postgres", "mysql", "sqlserver", "mongodb", "kafka", "s3"]
    },
    "type": { "enum": ["full", "cdc", "incremental"] },
    "cron": { "type": "string", "description": "NiFi Quartz cron expression (6 fields: sec min hour day month weekday)" },
    "secrets": {
      "type": "object",
      "description": "Maps NiFi sensitive parameter names to Snowflake secret FQNs (OPENFLOW_FACTORY.SECRETS.<NAME>). At deploy time, the parameter value is set to reference the secret, which is resolved at runtime inside SPCS.",
      "additionalProperties": {
        "type": "string",
        "description": "Fully qualified Snowflake secret name (e.g. OPENFLOW_FACTORY.SECRETS.MY_SECRET)",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "assets": {
      "type": "object",
      "description": "Maps NiFi asset parameter names to file names. Files are resolved from the ingestion_engine/assets directory and uploaded to the flow's parameter context at deploy time.",
      "additionalProperties": {
        "type": "string",
        "description": "Asset file name (e.g. postgresql-42.7.11.jar)"
      }
    },
    "source_config": {
      "type": "object",
      "required": ["host", "port", "database", "schema", "tables"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "default": 5432 },
        "database": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "pii_columns"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
              "pii_columns": { "type": "array", "items": { "type": "string" } },
              "schema": { "type": "string" },
              "partition_column": { "type": "string" },
              "chunk_rows": { "type": "integer", "minimum": 1000 },
              "has_primary_key": { "type": "boolean" },
              "pre_sql": { "type": "string" },
              "post_sql": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": { "type": { "enum": ["full", "incremental"] } }
  },
  "then": {
    "required": ["cron"]
  }
}
