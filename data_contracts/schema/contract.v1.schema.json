{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Contract v1",
  "type": "object",
  "required": ["version", "source_sgdb", "type", "source_config"],
  "properties": {
    "version": { "const": "v1" },
    "source_sgdb": {
      "enum": ["postgres", "mysql", "sqlserver", "mongodb", "kafka", "s3"]
    },
    "type": { "enum": ["full", "cdc", "incremental", "consume"] },
    "cron": { "type": "string", "description": "NiFi Quartz cron expression (6 fields: sec min hour day month weekday)" },
    "promote_strategy": {
      "enum": ["merge", "append"],
      "default": "append",
      "description": "How incremental rows are promoted to the destination table. 'append' inserts rows as-is (suitable for immutable/event tables). 'merge' upserts rows into the destination using primary key matching via a journal table (suitable for mutable dimension tables)."
    },
    "secrets": {
      "type": "object",
      "description": "Maps NiFi sensitive parameter names to Snowflake secret FQNs.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "assets": {
      "type": "object",
      "description": "Maps NiFi asset parameter names to file names in ingestion_engine/assets/.",
      "additionalProperties": { "type": "string" }
    },
    "source_config": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["full", "incremental"] } }, "required": ["type"] },
      "then": { "required": ["cron"] }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "incremental" },
          "source_sgdb": { "enum": ["postgres", "mysql", "sqlserver"] }
        }
      },
      "then": {
        "properties": {
          "promote_strategy": { "enum": ["merge", "append"], "default": "append" },
          "source_config": {
            "properties": {
              "tables": {
                "items": {
                  "anyOf": [
                    { "required": ["watermark_columns"] },
                    { "required": ["partition_column"] }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "enum": ["postgres", "mysql", "sqlserver"] } } },
      "then": {
        "properties": {
          "source_config": {
            "$ref": "#/$defs/relational_source_config"
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "postgres" } } },
      "then": {
        "properties": {
          "source_config": {
            "properties": {
              "port": { "default": 5432 },
              "replication_slot": { "type": "string", "description": "Required for CDC. Logical replication slot name." },
              "publication": { "type": "string", "description": "Required for CDC. Publication name." }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "sqlserver" } } },
      "then": {
        "properties": {
          "source_config": {
            "properties": {
              "port": { "default": 1433 },
              "instance": { "type": "string", "description": "Named instance (optional)." },
              "encrypt": { "type": "boolean", "default": true, "description": "Whether to use encrypted connection." },
              "trust_server_certificate": { "type": "boolean", "default": true, "description": "Trust self-signed certs." }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "mysql" } } },
      "then": {
        "properties": {
          "source_config": {
            "properties": {
              "port": { "default": 3306 },
              "server_id": { "type": "integer", "description": "Required for CDC. Unique server ID for binlog replication." }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "mongodb" } } },
      "then": {
        "properties": {
          "source_config": {
            "$ref": "#/$defs/mongodb_source_config"
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "kafka" } } },
      "then": {
        "properties": {
          "source_config": {
            "$ref": "#/$defs/kafka_source_config"
          }
        }
      }
    },
    {
      "if": { "properties": { "source_sgdb": { "const": "s3" } } },
      "then": {
        "properties": {
          "source_config": {
            "$ref": "#/$defs/s3_source_config"
          }
        }
      }
    }
  ],
  "$defs": {
    "table_def": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "pii_columns": { "type": "array", "items": { "type": "string" }, "default": [] },
        "schema": { "type": "string", "description": "Override schema for this table." },
        "partition_column": { "type": "string", "description": "Column for chunked/parallel reads. If unset, chunk_rows is forced to 0 (single fetch)." },
        "watermark_columns": { "type": "array", "items": { "type": "string" }, "description": "List of columns for incremental high-watermark tracking (e.g. ['updated_at', 'id']). Used by incremental strategies." },
        "chunk_rows": { "type": "integer", "minimum": 0, "default": 5000, "description": "Rows per chunk. Defaults to 5000 if partition_column is set, otherwise 0." },
        "has_primary_key": { "type": "boolean" },
        "pre_sql": { "type": "string", "description": "SQL to run before fetching this table." },
        "post_sql": { "type": "string", "description": "SQL to run after fetching this table." },
        "exclude_columns": { "type": "array", "items": { "type": "string" }, "description": "Columns to exclude from ingestion." },
        "where_clause": { "type": "string", "description": "Filter predicate for this table." }
      }
    },
    "relational_source_config": {
      "type": "object",
      "required": ["host", "database", "tables"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer" },
        "database": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "default": "dbo" },
        "username": { "type": "string" },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/table_def" }
        },
        "connection_properties": {
          "type": "object",
          "description": "Additional JDBC connection properties passed as key=value.",
          "additionalProperties": { "type": "string" }
        },
        "fetch_size": { "type": "integer", "default": 10000, "description": "JDBC fetch size." },
        "query_timeout": { "type": "integer", "description": "Query timeout in seconds." }
      }
    },
    "mongodb_source_config": {
      "type": "object",
      "required": ["connection_string", "database", "collections"],
      "properties": {
        "connection_string": { "type": "string", "description": "MongoDB connection URI." },
        "database": { "type": "string" },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "pii_fields": { "type": "array", "items": { "type": "string" }, "default": [] }
            }
          }
        }
      }
    },
    "kafka_source_config": {
      "type": "object",
      "required": ["bootstrap_servers", "username", "database", "schema", "topics"],
      "properties": {
        "bootstrap_servers": { "type": "string", "minLength": 1, "description": "Comma-separated broker list (host:port)." },
        "username": { "type": "string", "minLength": 1, "description": "SASL username." },
        "database": { "type": "string", "minLength": 1, "description": "Snowflake destination database." },
        "schema": { "type": "string", "minLength": 1, "description": "Snowflake destination schema." },
        "topics": { "type": "string", "minLength": 1, "description": "Comma-separated topic names or pattern." },
        "security_protocol": { "type": "string", "enum": ["SASL_SSL", "SASL_PLAINTEXT", "SSL", "PLAINTEXT"], "default": "SASL_SSL" },
        "sasl_mechanism": { "type": "string", "enum": ["SCRAM-SHA-512", "SCRAM-SHA-256", "PLAIN", "OAUTHBEARER"], "default": "SCRAM-SHA-512" },
        "group_id": { "type": "string", "description": "Consumer group ID. Defaults to 'openflow_msk_connector'." },
        "auto_offset_reset": { "type": "string", "enum": ["earliest", "latest"], "default": "earliest" },
        "message_format": { "type": "string", "enum": ["JSON", "AVRO", "CONFLUENT_ENCODED"], "default": "JSON" },
        "topic_format": { "type": "string", "enum": ["names", "pattern"], "default": "names", "description": "Whether 'topics' is a list of names or a regex pattern." },
        "dlq_topic": { "type": "string", "description": "Dead-letter queue topic for failed messages." },
        "schema_registry_url": { "type": "string", "description": "Confluent Schema Registry URL (required for AVRO/CONFLUENT_ENCODED)." },
        "schema_registry_username": { "type": "string" },
        "schema_registry_auth_type": { "type": "string", "enum": ["NONE", "BASIC", "URL"], "default": "NONE" },
        "avro_schema": { "type": "string", "description": "Inline AVRO schema (optional, alternative to registry)." },
        "avro_schema_access_strategy": { "type": "string", "default": "embedded-avro-schema" },
        "iceberg_enabled": { "type": "string", "enum": ["true", "false"], "default": "false", "description": "Write to Iceberg tables." },
        "schematization_enabled": { "type": "string", "enum": ["true", "false"], "default": "true", "description": "Auto-evolve destination schema from messages." },
        "topic_to_table_map": { "type": "string", "description": "JSON mapping of topic names to table names (optional)." }
      }
    },
    "s3_source_config": {
      "type": "object",
      "required": ["bucket"],
      "properties": {
        "bucket": { "type": "string" },
        "prefix": { "type": "string", "default": "" },
        "region": { "type": "string", "default": "us-west-2" },
        "file_format": { "type": "string", "enum": ["json", "csv", "parquet", "avro"], "default": "json" },
        "compression": { "type": "string", "enum": ["none", "gzip", "snappy", "zstd"], "default": "none" },
        "sqs_queue_url": { "type": "string", "description": "SQS queue for event-driven ingestion (optional)." }
      }
    }
  }
}
